# Names only. Copy to .env locally and fill in; deployed values come from Azure Key Vault.

# App
APP_ENV=
LOG_LEVEL=

# API security (§6.7)
API_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# LLM (§6.5)
LLM_PROVIDER=
LLM_MODEL=
LLM_ENDPOINT=
LLM_API_KEY=

# Databricks (Gold access)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_SQL_HTTP_PATH=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA_GOLD=

# Azure (§6.6)
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_CLIENT_ID=
AZURE_KEY_VAULT_URL=
